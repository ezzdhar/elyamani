# ELYAMANI Environment Configuration Example
# Copy to .env for local development or set in your hosting control panel

# Nuxt Frontend Configuration
# Target external Hostinger PHP API URL for production deployment on GitHub Pages
# Configure this in GitHub: Repo Settings -> Secrets and variables -> Actions -> Variables -> NUXT_PUBLIC_CONTACT_API_URL
NUXT_PUBLIC_CONTACT_API_URL=https://el-yamani.com/api/contact.php

# ==============================================================================
# OPTION 1: GMAIL SMTP WITH APP PASSWORD (RECOMMENDED FOR GUARANTEED INBOX DELIVERY)
# ==============================================================================
# Generate a 16-character App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=tls
# SMTP_USER=elyamani.cfd@gmail.com
# SMTP_PASS=YOUR_16_DIGIT_GMAIL_APP_PASSWORD
# SMTP_FROM_EMAIL=elyamani.cfd@gmail.com
# SMTP_FROM_NAME="ELYMANI Website"
# SMTP_TO_EMAIL=elyamani.cfd@gmail.com
# SMTP_TO_NAME=ELYAMANI

# ==============================================================================
# OPTION 2: HOSTINGER EMAIL ACCOUNT (requires creating a mailbox in hPanel)
# ==============================================================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=noreply@el-yamani.com
SMTP_PASS=YOUR_HOSTINGER_EMAIL_PASSWORD
SMTP_FROM_EMAIL=noreply@el-yamani.com
SMTP_FROM_NAME="ELYMANI Website"
SMTP_TO_EMAIL=elyamani.cfd@gmail.com
SMTP_TO_NAME=ELYAMANI

ALLOWED_ORIGINS=https://el-yamani.com,https://www.el-yamani.com,https://ezzdhar.github.io,http://localhost:3000
