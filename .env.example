# ELYAMANI Environment Configuration Example
# Copy to .env for local development

# Nuxt Frontend Configuration
# Target external Hostinger PHP API URL for production deployment on GitHub Pages
# Configure this in GitHub: Repo Settings -> Secrets and variables -> Actions -> Variables -> NUXT_PUBLIC_CONTACT_API_URL
NUXT_PUBLIC_CONTACT_API_URL=https://api.el-yamani.com/api/contact.php

# PHP Backend SMTP Configuration (Hostinger Server Environment / .env)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=noreply@el-yamani.com
SMTP_PASS=YOUR_HOSTINGER_EMAIL_PASSWORD
SMTP_FROM_EMAIL=noreply@el-yamani.com
SMTP_FROM_NAME="ELYMANI Website"
SMTP_TO_EMAIL=elyamani.cfd@gmail.com
SMTP_TO_NAME=ELYAMANI
ALLOWED_ORIGINS=https://el-yamani.com,https://www.el-yamani.com,https://ezzdhar.github.io,http://localhost:3000
