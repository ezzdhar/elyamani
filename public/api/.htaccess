# Protect sensitive files on Apache / LiteSpeed (Hostinger)
<FilesMatch "^(contact-config\.php|\.env.*|composer\.(json|lock)|.*\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
